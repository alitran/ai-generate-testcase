# Provider mặc định: openai | anthropic | gemini | openai_compatible
AI_PROVIDER=openai
# Tuỳ chọn: nếu đặt, AI_MODEL sẽ ghi đè model riêng của provider đã chọn.
# AI_MODEL=

# OpenAI
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Anthropic Claude: dùng API key và model ID được cấp trong tài khoản Anthropic của bạn.
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
ANTHROPIC_MODEL=your_claude_model_id
ANTHROPIC_MAX_TOKENS=8192

# Google Gemini: GOOGLE_API_KEY lấy từ môi trường Google AI/Gemini bạn được phép dùng.
GOOGLE_API_KEY=replace_with_your_google_api_key
GEMINI_MODEL=your_gemini_model_id

# Endpoint tương thích OpenAI Chat Completions, ví dụ một gateway được công ty phê duyệt
# hoặc server model local. Dùng đúng base URL/model theo tài liệu của endpoint đó.
OPENAI_COMPATIBLE_API_KEY=local-no-key
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_MODEL=your_local_model_id
